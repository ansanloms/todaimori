{
  "name": "@ansanloms/todaimori-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "run-s lint:check lint:redocly",
    "lint:check": "npm run check",
    "lint:redocly": "redocly lint --config ./redocly.yaml",
    "test": "node --test \"bin/*.test.ts\"",
    "fix": "run-s --continue-on-error sort lint",
    "build": "run-s build:bundle build:docs",
    "build:bundle": "redocly bundle ./api.yaml --config ./redocly.yaml --ext yaml --output ./dist/api.yaml",
    "build:docs": "redocly build-docs ./api.yaml --config ./redocly.yaml --inlineBundle --output ./dist/index.html",
    "sort": "node ./bin/sort.ts",
    "start": "vite preview --port 4000",
    "dev": "vite"
  },
  "devDependencies": {
    "@ansanloms/redocly-plugins": "github:ansanloms/redocly-plugins#0.4.0",
    "@redocly/cli": "2.80.0",
    "@redocly/openapi-core": "2.80.0",
    "@types/node": "26.6.6",
    "npm-run-all2": "9.0.4",
    "openapi-types": "12.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "yaml": "2.9.1"
  }
}
