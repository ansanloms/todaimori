{
  "name": "todaimori",
  "private": true,
  "workspaces": [
    "packages/server",
    "packages/client/*"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check && textlint .",
    "fix": "oxlint --fix && textlint . --fix && oxfmt",
    "test": "node --test \"packages/**/*.test.ts\""
  },
  "devDependencies": {
    "@ansanloms/textlint-plugin-yaml-keys": "github:ansanloms/textlint-plugin-yaml-keys#0.2.0",
    "@proofdict/textlint-rule-proofdict": "3.1.2",
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "@types/node": "26.6.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "textlint": "16.1.1",
    "textlint-rule-preset-ja-spacing": "3.1.0",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-preset-jtf-style": "3.1.0",
    "typescript": "7.0.2"
  }
}
